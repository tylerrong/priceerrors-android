<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PriceErrors" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Android 12+ adds the branded system splash attributes in values-v31.
         On earlier versions this remains identical to the normal app theme. -->
    <style name="Theme.PriceErrors.Starting" parent="Theme.PriceErrors" />
</resources>
